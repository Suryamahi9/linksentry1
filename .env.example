# LinkSentry Environment Variables

# API Server
API_PORT=3001
API_HOST=0.0.0.0
# Comma-separated list of allowed browser origins (unchanged = defaults)
CORS_ORIGIN=http://localhost:3000,http://localhost:8000

# Frontend
# Server-only: where the same-origin /api/* proxy rewrites to. Set this on
# Vercel (build-time) to your deployed API URL, e.g. https://api.up.railway.app
API_UPSTREAM=http://localhost:3001

# --- Stage 2: External Threat Intelligence Providers ---
# Google Safe Browsing API key (get from Google Cloud Console → APIs & Services → Credentials)
# GOOGLE_SAFE_BROWSING_API_KEY=

# VirusTotal API key (get from https://www.virustotal.com/gui/my-apikey)
# VIRUSTOTAL_API_KEY=

# PhishTank API key (get from https://phishtank.org/developer_info.php)
# PHISHTANK_API_KEY=

# URLhaus API key (get from https://urlhaus-api.abuse.ch/)
# URLHAUS_API_KEY=

# --- Stage 3: Database & Queue ---
# POSTGRES_URL=postgresql://user:password@localhost:5432/linksentry
# REDIS_URL=redis://localhost:6379

# --- Stage 3: Auth ---
# AUTH_SECRET=your-auth-secret-here
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
# EMAIL_FROM=linksentry@yourdomain.com
